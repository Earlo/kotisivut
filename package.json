{
  "name": "kotisivut",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "dev": "next dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings && tailwind-lint --auto --format json | node scripts/lint-tailwind.mjs",
    "lint:fix": "oxlint --fix && tailwind-lint --auto --fix",
    "prettier": "npm run format",
    "start": "next start",
    "test": "node --test",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "@next/third-parties": "16.3.5",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "2.1.1",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "postcss": "8.5.28",
    "prettier": "3.9.7",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwind-lint": "0.12.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  }
}

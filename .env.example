SUPABASE_URL=
SUPABASE_KEY=
# Optional server key alias; takes precedence over SUPABASE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Outside Vercel, select a header overwritten by your trusted reverse proxy.
# Supported: x-vercel-forwarded-for, cf-connecting-ip, fly-client-ip, x-real-ip.
# Leave empty for local development or use the shared unknown-address bucket.
SUBMISSION_IP_HEADER=
